{
  "name": "el-mekina",
  "version": "1.0.0",
  "description": "ELMAKINA — real-time online hidden-role bluffing game for 2–6 players (Supabase serverless: Edge Function + Postgres + Realtime; React + HeroUI client)",
  "main": "supabase/functions/_shared/engine.mjs",
  "scripts": {
    "build": "vite build --config client/vite.config.ts",
    "build:native": "VITE_PLATFORM=native vite build --config client/vite.config.ts",
    "sync:native": "npm run build:native && cap sync && node scripts/prune-native-assets.js",
    "apk": "npm run sync:native && cd android && JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" ./gradlew assembleDebug",
    "apk:install": "npm run apk && \"${ANDROID_HOME:-$HOME/Library/Android/sdk}/platform-tools/adb\" install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "open:android": "npm run sync:native && cap open android",
    "dev": "vite --config client/vite.config.ts",
    "start": "vite preview --config client/vite.config.ts",
    "typecheck": "tsc -p client/tsconfig.json",
    "test": "node test/engine.test.mjs && node test/flow.test.mjs",
    "test:engine": "node test/engine.test.mjs",
    "test:flow": "node test/flow.test.mjs",
    "supabase:link": "supabase link",
    "supabase:deploy": "supabase db push && supabase functions deploy game",
    "supabase:serve": "supabase functions serve game --env-file .env",
    "icons": "node scripts/tint-icons.js",
    "assets": "node scripts/build-assets.js",
    "splash": "node scripts/build-splash.js",
    "android": "bash scripts/run-android.sh",
    "appicons": "node scripts/build-app-icons.js",
    "bundle": "npm run sync:native && cd android && JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" ./gradlew bundleRelease"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@sentry/react": "^10.73.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "supabase": "^3.0.0-beta.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@fontsource-variable/oswald": "^5.3.0",
    "@multiavatar/multiavatar": "^1.0.7",
    "dexie": "^4.4.5",
    "lottie-web": "^5.13.0"
  }
}
