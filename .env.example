# ELMEKINA — configuration (copy to .env; .env is gitignored, this file is NOT)
#
# NEVER put a real key in this file. It is committed. Placeholders only.
# The values below are shapes, not secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Browser client (Vite): project URL + anon (public) key — Project Settings → API.
# The anon key is safe to ship: it is public by design and protected by RLS.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Only for `npm run supabase:serve` (local Edge Function runtime via Docker).
# The service_role key bypasses every RLS policy — it must NEVER reach the browser,
# a build, or this file. Keep it in the untracked .env only.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Voice (optional) ──────────────────────────────────────────────────────────
# TURN relay for WebRTC voice, needed when players sit behind symmetric NAT / mobile carriers.
# Leave unset to use Google STUN only. Creds from Twilio, Metered, Cloudflare or self-hosted coturn.
VITE_TURN_URLS=<turn-host:port>
VITE_TURN_USERNAME=<turn-username>
VITE_TURN_CREDENTIAL=<turn-credential>

# ── Google Analytics (optional) ───────────────────────────────────────────────
# GA4 Measurement ID. The live property is the default inside client/src/lib/analytics.ts, so
# production needs nothing here. Set it only to point a build at a different property.
# Leave blank: `npm run dev` sends nothing, production builds use the default.
# NB the `G-` prefix is part of the id — without it the value fails validation and is ignored.
VITE_GA_ID=
# AdSense publisher ID. The live one is the default in client/src/lib/google.ts (and must match
# public/ads.txt + the meta tag in client/index.html), so production needs nothing here.
VITE_ADSENSE_CLIENT=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a pair (any web-push tool, or the snippet in supabase/functions/push). The PUBLIC key
# ships to the browser and is public by design. The PRIVATE key belongs in the Supabase secret
# store and nowhere else — never in this repo, never in a build.
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=
