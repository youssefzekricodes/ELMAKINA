# ELMAKINA — Supabase configuration (copy to .env)
# Browser client (Vite): project URL + anon (public) key — Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Optional: TURN relay for WebRTC voice (needed when players are behind symmetric NAT / mobile carriers).
# Leave unset to use Google STUN only. Get creds from Twilio, Metered, Cloudflare, or self-hosted coturn.
#VITE_TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
#VITE_TURN_USERNAME=<turn user>
#VITE_TURN_CREDENTIAL=<turn credential>

# Only needed for `npm run supabase:serve` (local Edge Function runtime via Docker); never ship this to the browser
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
