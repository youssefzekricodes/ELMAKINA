# ELMEKINA — configuration (copy to .env; .env is gitignored, this file is NOT)
#
# NEVER put a real key in this file. It is committed. Placeholders only.
# The values below are shapes, not secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Browser client (Vite): project URL + anon (public) key — Project Settings → API.
# The anon key is safe to ship: it is public by design and protected by RLS.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Only for `npm run supabase:serve` (local Edge Function runtime via Docker).
# The service_role key bypasses every RLS policy — it must NEVER reach the browser,
# a build, or this file. Keep it in the untracked .env only.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Voice (optional) ──────────────────────────────────────────────────────────
# TURN relay for WebRTC voice, needed when players sit behind symmetric NAT / mobile carriers.
# Leave unset to use Google STUN only. Creds from Twilio, Metered, Cloudflare or self-hosted coturn.
VITE_TURN_URLS=<turn-host:port>
VITE_TURN_USERNAME=<turn-username>
VITE_TURN_CREDENTIAL=<turn-credential>

# ── Google Analytics (optional) ───────────────────────────────────────────────
# GA4 Measurement ID. The live property is the default inside client/src/lib/analytics.ts, so
# production needs nothing here. Set it only to point a build at a different property.
# Leave blank: `npm run dev` sends nothing, production builds use the default.
# NB the `G-` prefix is part of the id — without it the value fails validation and is ignored.
VITE_GA_ID=
# AdSense publisher ID. The live one is the default in client/src/lib/google.ts (and must match
# public/ads.txt + the meta tag in client/index.html), so production needs nothing here.
VITE_ADSENSE_CLIENT=

# ── App builds: platform + AdMob ─────────────────────────────────────────────
# VITE_PLATFORM=native marks a build destined for the Capacitor shell instead of a browser.
# It removes the AdSense loader AND the google-adsense-account meta tag from the HTML, because
# AdSense's terms forbid its code inside an application — running it there risks the publisher
# account, website revenue included. Use `npm run build:native`, which sets this for you.
# Leave blank for the normal web build.
VITE_PLATFORM=

# AdMob interstitial UNIT ids — the app's equivalent of AdSense, one per platform. Note the slash:
# ca-app-pub-<digits>/<digits> is a unit, ca-app-pub-<digits>~<digits> is the APPLICATION id and
# belongs in AndroidManifest.xml / Info.plist instead (those two are already wired, in
# client/src/lib/google.ts and the Android manifest).
#
# Leave blank and the app shows no ads at all. Set the literal `test` to use Google's public test
# units — always do that while developing, because clicking your own live ads is invalid traffic and
# AdMob suspends accounts for it.
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
# Rewarded video units (streak save, trophy boost) — same rules as above. Leave blank for none;
# `test` uses Google's public rewarded test units, and setting `test` on the INTERSTITIAL var
# already covers these too, so a dev build needs only one switch.
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=

# Register ONE PHYSICAL device so your real ad units serve TEST creatives to it. This is how you
# verify a live ad unit without generating invalid traffic: the request uses YOUR unit, so a wrong
# id or an unactivated one still fails loudly, but the creative is Google's and clicks count as
# nothing. Clicking your own live ads is invalid traffic and AdMob suspends accounts for it.
#
# NOT NEEDED ON AN EMULATOR. The SDK treats every emulator as a test device automatically — it logs
# "This request is sent from a test device." with no configuration at all, so `npm run android`
# against an AVD is always safe with real ad unit ids.
#
# For a real phone, run it once and read the id out of the log:
#   ~/Library/Android/sdk/platform-tools/adb logcat | grep -i "setTestDeviceIds"
# The SDK prints: Use ... setTestDeviceIds(Arrays.asList("33BE2250B43518CCDA7DE426D04EE231"))
VITE_ADMOB_TEST_DEVICE=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a pair (any web-push tool, or the snippet in supabase/functions/push). The PUBLIC key
# ships to the browser and is public by design. The PRIVATE key belongs in the Supabase secret
# store and nowhere else — never in this repo, never in a build.
#   supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=

# ── Error monitoring (Sentry) ────────────────────────────────────────────────
# Optional. Unset, the app and the functions behave exactly as they did before — the Sentry chunk
# is never even fetched. Create a project at sentry.io and take the DSN from it.
#
# Browser (set this in Netlify's environment too, or the deployed build has no DSN baked in):
VITE_SENTRY_DSN=
# Edge Functions — the SAME DSN, set as a function secret:
#   supabase secrets set SENTRY_DSN=... SENTRY_ENV=production
