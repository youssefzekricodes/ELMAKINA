<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's own ground: the app's dark wood, rounded to the launcher's radius. The scene art is
  NOT here — a bitmap in a drawable can only stretch (fill) or sit unscaled, and stretching a
  760x234 banner into whatever box the launcher hands out squashed the faces. The art is an
  ImageView with centerCrop on top of this (layout/widget_streak.xml); this layer is what shows
  in the corners it leaves on pre-12 launchers, and the colour the launcher fades in from.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <corners android:radius="@dimen/widget_radius" />
  <solid android:color="#0E0B08" />
</shape>
