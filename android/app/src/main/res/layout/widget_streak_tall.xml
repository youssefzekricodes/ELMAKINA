<?xml version="1.0" encoding="utf-8"?>
<!--
  android:id="@android:id/background" is load-bearing, not decoration: from Android 12 the launcher
  uses that id to clip the widget to the system corner radius and draw its backing. A custom id
  there is how a widget lands on the home screen with no visible background at all.

  The two-row form (the default): the same strip, taller and larger — flame and number as a
  headline with the nudge under them, centred on the banner art (centerCrop, so nothing
  stretches). StreakWidget.java picks this or the one-row form from the size the launcher reports,
  and swaps the art between the warm and the frozen banner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

  <ImageView
      android:id="@+id/widget_art"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="centerCrop"
      android:src="@drawable/widget_warm"
      android:contentDescription="@null" />

  <!-- An ImageView, not a View: RemoteViews refuses to inflate a bare View ("Class not allowed"). -->
  <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/widget_scrim"
      android:contentDescription="@null" />

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="14dp"
      android:paddingEnd="14dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_fire"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:src="@drawable/widget_fire"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/widget_count"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textSize="60sp"
          android:textStyle="bold"
          android:includeFontPadding="false"
          android:textColor="#FFC24A"
          android:shadowColor="#8CE2551A"
          android:shadowDx="0"
          android:shadowDy="0"
          android:shadowRadius="18"
          android:text="0" />
      <TextView
          android:id="@+id/widget_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:maxLines="2"
          android:maxWidth="170dp"
          android:ellipsize="end"
          android:textSize="13sp"
          android:textStyle="bold"
          android:includeFontPadding="false"
          android:textColor="#F3E9D6"
          android:shadowColor="#CC000000"
          android:shadowDx="0"
          android:shadowDy="1"
          android:shadowRadius="4"
          android:text="" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
